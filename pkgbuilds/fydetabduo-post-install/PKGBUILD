# Maintainer: Panda <panda@fydeos.io>

pkgname=fydetabduo-post-install
pkgver=20$(date +%y%m%d)
pkgrel=9
pkgdesc="Fixes for Fydetab Duo"
arch=('any')
url="https://fydetabduo.com/"
license=('GPL')
depends=('iwd' 'iw' 'ap6275p-firmware' 'iio-sensor-proxy' 'touchegg' 'xorg-xinput' 'xorg-xrandr' 'alsa-ucm-conf')
optdepends=('gnome-shell-extension-gjs-osk: on-screen keyboard for the GNOME image')
install=fydetab.install
backup=('etc/sddm.conf.d/fydetab.conf')
source=('fydetabduo.service'
        'fix-display'
        'settings.conf'
        'fix-display.service'
        '50-suspend-state.conf'
        '60-fydetab-wake-screen'
        'fydetab-user-activity'
        '50-enable-screen-rotate.conf'
        'brcm_patchram_plus'
        'bluetooth-fix'
        'bluetooth-fydetab.service'
        'fydetab.rules'
        '90-fydetab.hwdb'
        '99-fydetab.conf'
        'Himax_firmware.bin'
        '50-fydetab-wowlan-off.conf'
        'rockchip-es8388-ucm.conf'
        'rockchip-es8388-HiFi.conf')
# Himax_firmware.bin (touch controller fw) is vendored from openFyde's
# overlay-fydetab_duo-openfyde chromeos-bsp files/firmware; content is
# identical across their r120-dev..r150 branches (sha cf4a7fcd...).
# rockchip-es8388-*.conf: UCM2 port of openFyde's UCM v1 profile
# (chromeos-bsp-inaugural ucm-config/HiFi-nomic.conf); without it no ALSA
# UCM profile matches the card and the codec output path stays muted.
sha256sums=('343e4c18af992ac8db223cf950df9108222ff8345be5b59d6ad45c7ad35ea096'
