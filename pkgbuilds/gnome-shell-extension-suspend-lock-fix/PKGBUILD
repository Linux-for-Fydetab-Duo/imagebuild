# Maintainer: Panda <panda@fydeos.io>
pkgname=gnome-shell-extension-suspend-lock-fix
pkgver=1.0
pkgrel=1
pkgdesc="Lock the screen without animation so suspend cannot outrun the lock"
arch=('any')
url="https://github.com/openFyde/fydetab-archlinux"
license=('GPL2')
depends=('gnome-shell')
# The shield's animated suspend-lock cannot finish before the system
# sleeps (gsd-power blanks the panel at PrepareForSleep, starving the
# animation of frames; logind's 5s InhibitDelayMaxSec then expires), so
# its deferred ActiveChanged(true) fires seconds AFTER resume and
# gsd-power blanks the freshly woken screen. The extension forces the
# non-animated lock path, which releases the inhibitor and emits
# ActiveChanged synchronously before the system sleeps. Real fix
# belongs upstream in gnome-shell's ScreenShield._prepareForSleep.
source=('extension.js'
        'metadata.json'
        '90-fydetab-extensions.gschema.override')
sha256sums=('SKIP'
            'SKIP'
            'SKIP')

package() {
    local extdir="$pkgdir/usr/share/gnome-shell/extensions/suspend-lock-fix@fydeos.io"
    install -Dm644 "$srcdir/extension.js" "$extdir/extension.js"
    install -Dm644 "$srcdir/metadata.json" "$extdir/metadata.json"
    # glib2's pacman hook recompiles the schemas on install/remove.
    install -Dm644 "$srcdir/90-fydetab-extensions.gschema.override" \
        "$pkgdir/usr/share/glib-2.0/schemas/90-fydetab-extensions.gschema.override"
}
