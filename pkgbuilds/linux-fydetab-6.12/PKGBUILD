# AArch64 multi-platform
# Maintainer: Panda <panda@fydeos.io>

buildarch=8
_kernel=linux-fydetab
pkgbase=$_kernel
pkgname=("${pkgbase}-headers" $pkgbase)
pkgver=6.12.43
pkgrel=18
arch=('aarch64')
license=('GPL2')
url="https://github.com/Linux-for-Fydetab-Duo/linux-fydetabduo"
pkgdesc="The Linux Kernel and modules"
# optdepends=('mali-G610-firmware-rkr4: Mali G610 firmware for Rockchip RK3588')
# vboot-utils dropped from upstream's makedepends: nothing in this PKGBUILD
# invokes futility/vbutil (it is a leftover from ChromeOS kernel-partition
# packaging), and the package does not exist in x86_64 repos, which would make
# cross-building impossible for a tool that is never run.
makedepends=('xmlto' 'docbook-xsl' 'kmod' 'inetutils' 'bc' 'git' 'uboot-tools' 'dtc')
options=('!strip' 'ccache')
source=(git+https://github.com/Linux-for-Fydetab-Duo/linux-fydetabduo.git#branch=linux-v6.12
        'linux.preset')
md5sums=('SKIP'
         'SKIP')
prepare() {
  :
}

build() {
  cd linux-fydetabduo

  # Keep the kernel release string stable across every make invocation.
  # LOCALVERSION set-but-empty tells scripts/setlocalversion to append
  # nothing -- neither the '+' for a dirty tree (this PKGBUILD dirties the
  # tree by sedding the Makefile) nor a -g<hash>-dirty suffix. The old
  # 'echo > .scmversion' trick stopped working before 6.x: setlocalversion
  # no longer reads that file. Upstream's ordering also computed the
  # 'version' file under `make olddefconfig` -- the DEFAULT config, where
  # LOCALVERSION_AUTO=y -- while building under fydetabduo_defconfig, so
  # package() installed vmlinuz under one release string and the modules
  # under another, and the image could not find its own module tree.
  export LOCALVERSION=

  sed -i 's|-std=gnu89|-std=gnu89 -Wno-array-compare -Wno-dangling-pointer -Wno-stringop-overread -Wno-misleading-indentation -Wno-address -Wno-unused-function|g' Makefile
  sed -i 's|^EXTRAVERSION =.*|EXTRAVERSION = -fydetabduo|g' Makefile

  # Configure with the real config FIRST; everything after -- prepare, the
  # version file, the build itself -- must agree on it.
  make ${MAKEFLAGS} fydetabduo_defconfig

  # The ChromeOS defconfig ships no nftables at all, but Arch's iptables
  # binaries are nft-backed symlinks, so ufw (and docker's NAT setup) fail
  # on the device with "Failed to initialize nft". ufw's default ruleset
  # additionally needs the recent match (limit 22/tcp) and the LOG target,
  # its before6.rules need the hl and rt matches (ICMPv6 ND sanity rules,
  # RH0 drops -- iptables-nft still uses the xt extensions for these, it
  # does not translate them to native nft expressions),
  # and docker's bridge isolation wants br_netfilter. Diagnosed 2026-08-18:
  # ufw.service fails open without these. TEST fragment -- fold into
  # fydetabduo_defconfig once verified on device.
  ./scripts/config -m NF_TABLES -e NF_TABLES_INET -m NFT_COMPAT \
    -m NFT_LOG -m NFT_LIMIT -m NFT_CT -m NFT_NAT -m NFT_MASQ -m NFT_REJECT \
    -m NETFILTER_XT_MATCH_RECENT -m NETFILTER_XT_TARGET_LOG \
    -m NETFILTER_XT_MATCH_MULTIPORT -m BRIDGE_NETFILTER \
    -m NETFILTER_XT_MATCH_HL -m IP6_NF_MATCH_RT

  # Fourth ChromeOS-ism: the defconfig funnels every kernel usermodehelper
  # call through the single binary /sbin/usermode-helper (ChromeOS ships it
  # as a lockdown filter). Arch has no such binary, so every kernel-initiated
  # module autoload (request_module -> /sbin/modprobe) silently fails with
  # ENOENT: iptables-nft reports "Extension X is not supported" for any match
  # not already loaded, ufw dies fail-closed, and anything else relying on
  # on-demand module loading (mounts, crypto) only works if the module was
  # preloaded by other means. Manual modprobe is unaffected, which is why
  # this stayed hidden. Diagnosed on hardware 2026-08-18: creating the
  # missing helper as a modprobe shim instantly fixed autoload.
  ./scripts/config -d STATIC_USERMODEHELPER

  # fydetabduo_defconfig ships with CONFIG_RD_ZSTD off, but mkinitcpio (the
  # fyde build and stock >=30 alike) compresses the initramfs with zstd by
  # default. The kernel then silently drops the initramfs at boot
  # ("Initramfs unpacking failed: compression method zstd not configured"),
  # falls back to mounting root directly -- and the built-in panthor probes
  # BEFORE root is mounted, so the GPU firmware is unreachable and the probe
  # fails permanently. Diagnosed on hardware 2026-08-13.
  # LoadPin (a ChromeOS LSM) pins module AND firmware loading to the first
  # filesystem the kernel reads a file from. On ChromeOS that is the verity
  # rootfs and it is a sane hardening choice. On this image it is fatal in a
  # subtle, boot-order-dependent way: with a working initramfs the pin lands on
  # the INITRAMFS, and after switch-root every module load from the real root
  # is denied ("LoadPin: kernel-module denied", modprobe gets EPERM) -- no
  # touchscreen, no wifi, no bluetooth, empty lsmod. Diagnosed on hardware
  # 2026-08-13. An Arch system loads modules from the root filesystem by
  # design, so LoadPin cannot be enforced here at all.
  # Third ChromeOS-ism: the defconfig disables the VT layer (ChromeOS uses
  # frecon and never switches consoles). GDM starts user sessions on a NEW VT;
  # with CONFIG_VT=n the handoff after a successful password blocks forever --
  # greeter frozen with a stuck cursor, session never spawned, nothing in the
  # logs. Both the old working 6.1 config and FydeOS's own r150 kernel carry
  # VT=y; only this defconfig lacks it. Also gives back text consoles
  # (console=tty1) for on-device debugging. Diagnosed on hardware 2026-08-13.
  # ...but do NOT let the kernel VT-switch around suspend: with the slow VOP2
  # power-domain recovery on this board the switch-back lags for tens of
  # seconds and every resume detours through a visible kernel console.
  # Suspend diagnostics still reach the serial console. VT_CONSOLE_SLEEP is
  # a promptless `def_bool y` (olddefconfig re-forces it whenever
  # VT_CONSOLE && PM_SLEEP hold), so scripts/config -d cannot stick -- the
  # Kconfig default itself must be flipped.
  # The defconfig arms the DPM watchdog (a ChromeOS panic-and-report debug
  # feature): any device suspend/resume callback slower than 30s panics the
  # kernel. This board's vop2_wait_power_domain_off routinely takes ~24s on
  # display disable (pd0 never powers off, vendor VOP2/power-domain defect)
  # and sometimes exceeds 30s -- the machine then dies mid-suspend and needs
  # a forced power-off. Diagnosed on hardware 2026-08-13. A consumer image
  # must ride out slow PM callbacks, not panic on them.
  make ${MAKEFLAGS} olddefconfig
  grep -q "^CONFIG_RD_ZSTD=y" .config || { echo "RD_ZSTD did not take"; exit 1; }
  grep -q "^CONFIG_SECURITY_LOADPIN=y" .config && { echo "LOADPIN still enabled"; exit 1; }
  grep -q "^CONFIG_VT=y" .config || { echo "VT did not take"; exit 1; }
  grep -q "^CONFIG_FRAMEBUFFER_CONSOLE=y" .config || { echo "fbcon did not take"; exit 1; }
  grep -q "^CONFIG_VT_CONSOLE_SLEEP=y" .config && { echo "VT_CONSOLE_SLEEP still on"; exit 1; }
  grep -q "^CONFIG_DPM_WATCHDOG=y" .config && { echo "DPM_WATCHDOG still on"; exit 1; }
  grep -q "^CONFIG_NF_TABLES=m" .config || { echo "NF_TABLES did not take"; exit 1; }
  grep -q "^CONFIG_NFT_COMPAT=m" .config || { echo "NFT_COMPAT did not take"; exit 1; }
  grep -q "^CONFIG_NETFILTER_XT_MATCH_RECENT=m" .config || { echo "XT_MATCH_RECENT did not take"; exit 1; }
  grep -q "^CONFIG_NETFILTER_XT_TARGET_LOG=m" .config || { echo "XT_TARGET_LOG did not take"; exit 1; }
  grep -q "^CONFIG_STATIC_USERMODEHELPER=y" .config && { echo "STATIC_USERMODEHELPER still on"; exit 1; }
  grep -q "^CONFIG_NETFILTER_XT_MATCH_HL=m" .config || { echo "XT_MATCH_HL did not take"; exit 1; }
  grep -q "^CONFIG_IP6_NF_MATCH_RT=m" .config || { echo "IP6_NF_MATCH_RT did not take"; exit 1; }

  make ${MAKEFLAGS} prepare
  make -s kernelrelease > version
  unset LDFLAGS

  make ${MAKEFLAGS} Image modules
  make ${MAKEFLAGS} DTC_FLAGS="-@" dtbs
}

_package() {
  pkgdesc="The Linux Kernel and modules"
  depends=('coreutils' 'kmod' 'mkinitcpio>=0.7')
  optdepends=('wireless-regdb: to set the correct wireless channels of your country')
  provides=("linux-fydetab=${pkgver}" "linux" "panthor")
  backup=("etc/mkinitcpio.d/${_kernel}.preset")

  cd linux-fydetabduo

  # Same reasoning as in build(): the install targets below re-run
  # setlocalversion, and must produce the same release string.
  export LOCALVERSION=

  local _version="$(<version)"

  # install dtbs
  make INSTALL_DTBS_PATH="${pkgdir}/boot/dtbs/" dtbs_install

  # install modules
  make INSTALL_MOD_PATH="$pkgdir/usr" INSTALL_MOD_STRIP=1 modules_install

  # copy kernel
  install -Dm644 arch/arm64/boot/Image "$pkgdir/usr/lib/modules/$_version/vmlinuz"

  # sed expression for following substitutions
  local _subst="
    s|%PKGBASE%|${_kernel}|g
  "

  # used by mkinitcpio to name the kernel
  echo "$_kernel" | install -Dm644 /dev/stdin "$pkgdir/usr/lib/modules/$_version/pkgbase"

  # install mkinitcpio preset file
  sed "$_subst" ../linux.preset |
    install -Dm644 /dev/stdin "$pkgdir/etc/mkinitcpio.d/$_kernel.preset"
}

_package-headers() {
  pkgdesc="The Linux Kernel and modules - Headers"
  provides=("linux-headers=${pkgver}")

  cd linux-fydetabduo
  export LOCALVERSION=
  local _version="$(<version)"
  local builddir="$pkgdir/usr/lib/modules/$_version/build"

  echo "Installing build files..."
  install -Dt "$builddir" -m644 .config Makefile Module.symvers System.map version
  install -Dt "$builddir/kernel" -m644 kernel/Makefile
  install -Dt "$builddir/arch/arm64" -m644 arch/arm64/Makefile
  cp -t "$builddir" -a scripts

  # add xfs and shmem for aufs building
  mkdir -p "$builddir"/{fs/xfs,mm}

  echo "Installing headers..."
  cp -t "$builddir" -a include
  cp -t "$builddir/arch/arm64" -a arch/arm64/include
  install -Dt "$builddir/arch/arm64/kernel" -m644 arch/arm64/kernel/asm-offsets.s
  mkdir -p "$builddir/arch/arm"
  cp -t "$builddir/arch/arm" -a arch/arm/include

  install -Dt "$builddir/drivers/md" -m644 drivers/md/*.h
  install -Dt "$builddir/net/mac80211" -m644 net/mac80211/*.h

  # https://bugs.archlinux.org/task/13146
  install -Dt "$builddir/drivers/media/i2c" -m644 drivers/media/i2c/msp3400-driver.h

  # https://bugs.archlinux.org/task/20402
  install -Dt "$builddir/drivers/media/usb/dvb-usb" -m644 drivers/media/usb/dvb-usb/*.h
  install -Dt "$builddir/drivers/media/dvb-frontends" -m644 drivers/media/dvb-frontends/*.h
  install -Dt "$builddir/drivers/media/tuners" -m644 drivers/media/tuners/*.h

  # https://bugs.archlinux.org/task/71392
  install -Dt "$builddir/drivers/iio/common/hid-sensors" -m644 drivers/iio/common/hid-sensors/*.h

  echo "Installing KConfig files..."
  find . -name 'Kconfig*' -exec install -Dm644 {} "$builddir/{}" \;

  echo "Removing unneeded architectures..."
  local arch
  for arch in "$builddir"/arch/*/; do
    [[ $arch = */arm64/ || $arch == */arm/ ]] && continue
    echo "Removing $(basename "$arch")"
    rm -r "$arch"
  done

  echo "Removing documentation..."
  rm -r "$builddir/Documentation"

  echo "Removing broken symlinks..."
  find -L "$builddir" -type l -printf 'Removing %P\n' -delete

  echo "Removing loose objects..."
  find "$builddir" -type f -name '*.o' -printf 'Removing %P\n' -delete

  echo "Stripping build tools..."
  local file
  while read -rd '' file; do
    case "$(file -bi "$file")" in
      application/x-sharedlib\;*)      # Libraries (.so)
        strip -v $STRIP_SHARED "$file" ;;
      application/x-archive\;*)        # Libraries (.a)
        strip -v $STRIP_STATIC "$file" ;;
      application/x-executable\;*)     # Binaries
        strip -v $STRIP_BINARIES "$file" ;;
      application/x-pie-executable\;*) # Relocatable binaries
        strip -v $STRIP_SHARED "$file" ;;
    esac
  done < <(find "$builddir" -type f -perm -u+x ! -name -print0)

  echo "Adding symlink..."
  mkdir -p "$pkgdir/usr/src"
  ln -sr "$builddir" "$pkgdir/usr/src/$_kernel"
}

for _p in ${pkgname[@]}; do
  eval "package_${_p}() {
    _package${_p#${_kernel}}
  }"
done
