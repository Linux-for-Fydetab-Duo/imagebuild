# Maintainer: Panda <panda@fydeos.io>
pkgname=mali-G610-firmware-rkr4
pkgver=20$(date +%y%m%d)
pkgrel=4
pkgdesc="Mali G610 CSF firmware for Rockchip RK3588(S), placed for the panthor driver"
arch=('aarch64')
url="https://github.com/khadas/fenix/"
conflics=('mali-G610-firmware')
license=('unknown')
source=("mali_csffw.bin")
md5sums=('8cacdb33ddb8ccaa2281d318e60c1376')

# panthor builds the request path from the live GPU id as
# "arm/mali/arch<major>.<minor>/mali_csffw.bin" (panthor_fw.c, panthor_fw_load)
# and has no fallback to the bare name upstream, so the blob must sit at the
# arch-versioned path. G610 is Valhall CSF arch 10.8, which is also what the
# driver's MODULE_FIRMWARE hint names.
#
# A flat /usr/lib/firmware/mali_csffw.bin -- what this package installed through
# pkgrel 3 -- is the Rockchip vendor mali_kbase convention and is invisible to
# panthor. Note the failure is misreported: the driver's error prints CSF_FW_NAME
# ("mali_csffw.bin"), not the path it actually looked up, so a wrong arch
# directory looks exactly like a missing file.
#
# To confirm 10.8 against the real hardware, take the id from the probe line
#   dmesg | grep 'mali-.* id '     ->  "mali-g610 id 0xa867 major .. minor .."
# and read the arch off the TOP TWO NIBBLES of that id: 0xa867 -> 10.8.
# Do not use the "major"/"minor" printed on that same line -- those are
# GPU_VER_MAJOR/GPU_VER_MINOR, not the arch numbers that go into the path.
_csf_arch=10.8

package() {
    install -D -m 0644 "${srcdir}/mali_csffw.bin" \
        -t "${pkgdir}/usr/lib/firmware/arm/mali/arch${_csf_arch}"
}