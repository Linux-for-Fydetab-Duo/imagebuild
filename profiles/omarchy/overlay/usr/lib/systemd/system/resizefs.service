[Unit]
Description=Resize root filesystem
# Early boot, before basic.target: the image build ships the btrfs root
# shrunk to its minimum, so until this grows it to the medium the filesystem
# has only its chunk tails free -- nothing meaningful may write before then.
DefaultDependencies=no
After=systemd-remount-fs.service
# Before boot.mount as well: the script's partx re-read makes the ESP's
# device node flap, and systemd drops an already-mounted /boot when that
# happens -- the mount must come after the partition grow.
Before=boot.mount basic.target shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/usr/bin/resizefs
ExecStart=systemctl disable resizefs.service

[Install]
WantedBy=sysinit.target
