#!/bin/bash
# Grows the root partition to the end of the medium and then the filesystem to
# the end of the partition. Run once at first boot by resizefs.service.
# Credits to rpi-distro https://github.com/RPi-Distro/raspi-config/

# Root partition (e.g. /dev/mmcblk0p3), its kernel name, and the disk it is on.
PART_DEV=$(findmnt / -o source -n | cut -f1 -d"[")
PART_NAME=${PART_DEV#/dev/}
DEV_NAME=$(echo /sys/block/*/"${PART_NAME}" | cut -d "/" -f 4)
DEV="/dev/${DEV_NAME}"
PART_NUM=$(cat "/sys/block/${DEV_NAME}/${PART_NAME}/partition")

# Nothing left to claim on a medium that is already full, or on a second run.
# sfdisk fails in that case, which must not fail the unit.
echo ", +" | sfdisk --no-reread -N "$PART_NUM" "$DEV" \
    || echo "partition already fills the medium"

partx -u "$DEV"

if [[ $(findmnt / -o fstype -n) = btrfs ]]; then
    btrfs filesystem resize max /
else
    resize2fs "$PART_DEV"
fi

locale-gen
