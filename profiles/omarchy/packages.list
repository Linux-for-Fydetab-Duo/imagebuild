# Outside upstream's base manifest but installed by its ISO; the shipped
# zram config and sysctls assume it.
zram-generator

# =======
# OMARCHY
# =======
# The desktop meta-package itself is NOT in omarchy-base.packages -- upstream's
# ISO installs it separately. It pulls omarchy-settings (the /etc/skel config
# layer, the SDDM theme and /usr/local/share/wayland-sessions/omarchy.desktop),
# hyprland, quickshell, uwsm, sddm and omarchy-keyring. Our [fyde] rebuild has
# the limine bootloader deps removed, snapper kept (see
# pkgbuilds/OMARCHY-VENDOR.md).
omarchy

# ======
# DEVICE
# ======
# Fydetab Duo (RK3588S) enablement, from profiles/arch-gnome/packages.list.
base
base-devel
sudo
polkit
archlinux-keyring
archlinuxarm-keyring
fyde-keyring
fyde-mirrorlist
linux-fydetab
# The [fyde] mkinitcpio fork; linux-fydetab pulls it in as a dependency anyway,
# and [fyde] is first in the build-time pacman.conf, but naming it here keeps
# the initramfs generator explicit.
mkinitcpio
# Not the linux-firmware meta: its vendor subpackages (intel, nvidia, amdgpu,
# atheros, ...) are ~900 MB of firmware for hardware this board cannot have.
# -other carries the Mali CSF firmware panthor needs; Wi-Fi/BT firmware comes
# from ap6275p-firmware.
linux-firmware-other
linux-firmware-whence
ap6275p-firmware
# Board services, firmware and udev rules (fydetabduo.service,
# bluetooth-fydetab.service, fix-display.service, iio-sensor-proxy drop-in).
# WARNING: this package depends on gnome-shell-extension-gjs-osk, which pulls
# gnome-shell + gnome-settings-daemon + gjs into the image. The fix belongs in
# pkgbuilds/fydetabduo-post-install (make the on-screen-keyboard and X11
# gesture deps optdepends), not here.
fydetabduo-post-install
libdrm
cpupower
lm_sensors
lshw
e2fsprogs
parted
btrfs-progs
# The root is btrfs with upstream Omarchy's subvolume layout; snapper takes the
# pre-update snapshots omarchy-snapshot/omarchy-update expect.
snapper
# The overlay enables sshd.service; nothing in the Omarchy set pulls openssh.
openssh
pipewire-pulse
pipewire-alsa
pipewire-jack

# ===
# GPU  -- Mali G610 driven by the panthor kernel driver
# ===
# panthor (kernel, in linux-fydetab) + panfrost gallium (mesa) + panvk
# (vulkan-panfrost). NOT the Rockchip vendor mali_kbase blob, libmali or
# mesa-panfork-git.
#
# The CSF firmware comes from linux-firmware-other, which ships
# arm/mali/arch10.8/mali_csffw.bin. Our
# mali-G610-firmware-rkr4 package installs the same path and pacstrap fails on
# the file conflict, so it stays in the repo as a fallback but out of the image.
mesa
vulkan-panfrost
