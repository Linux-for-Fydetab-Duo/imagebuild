# Ownership and modes applied to the overlay after it is copied into the rootfs.
# Applied by stages/02-customize.sh, in file order.
#
# Format:  <path> <uid> <gid> <mode>
# A trailing slash on <path> means "chown recursively"; the mode is always
# applied to the named path only, never recursively.
#
# Needed because git records only the executable bit, so every overlay file
# arrives as 644 root:root.

/etc/                                   0    0    755
/home                                   0    0    755
/usr                                    0    0    755
/usr/bin                                0    0    755
/usr/lib                                0    0    755
/usr/lib/systemd                        0    0    755
/usr/share                              0    0    755
/usr/share/fydetab                      0    0    755

# Credential files. The overlay ships these at 644, and the previous build never
# corrected them -- the released images have world-readable password hashes for
# both root and the default 'omarchy' account (which share one hash). Do not
# reproduce that.
/etc/shadow                             0    0    600
/etc/gshadow                            0    0    600
/etc/passwd                             0    0    644
/etc/group                              0    0    644

# sudo refuses to parse a drop-in that is group- or world-writable, and 0440 is
# what visudo enforces.
/etc/sudoers.d                          0    0    750
/etc/sudoers.d/g_wheel                  0    0    440
/etc/polkit-1/rules.d                   0    0    750

# First-boot helper scripts. Both must be executable or their units die with
# 203/EXEC. (arch-gnome also lists /usr/bin/remove-calamares; this profile
# ships no calamares, so neither the script nor the entry is here.)
/usr/bin/resizefs                       0    0    755
/usr/bin/oemcleanup                     0    0    755

# CLI snapshot rollback, invoked by hand rather than by a unit.
/usr/bin/fydetab-snapshot-restore       0    0    755

# The first-boot encryption question. Its unit dies with 203/EXEC if this is not
# executable. The mkinitcpio hook files it works with need no entry: mkinitcpio
# sources them and stamps 755 into the cpio itself.
/usr/bin/fydetab-encrypt-setup          0    0    755

# First-boot provisioning state: `pending` arms the tty1 setup form, `groups`
# lists what the owner account is granted. Modes match what upstream stages.
# /var and /var/lib are listed for the same reason as /etc and /usr -- the
# overlay copy stamps its own directory modes onto the rootfs ones.
/var                                    0    0    755
/var/lib                                0    0    755
/var/lib/omarchy/                       0    0    755
/var/lib/omarchy/provisioning           0    0    755
/var/lib/omarchy/provisioning/pending   0    0    644
/var/lib/omarchy/provisioning/groups    0    0    644

# No per-user entry under /home: this profile bakes no user, so the owner's
# home is created by useradd during first-boot provisioning.
